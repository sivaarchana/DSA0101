#include <iostream>
#include <string>
using namespace std;

class BookFair
{
    string Bname;
    double price;
    double discount;
    double finalPrice;

public:

    void Input()
    {
        cout << "Enter book name: ";
        getline(cin, Bname);

        cout << "Enter price: ";
        cin >> price;
    }

    void calculate()
    {
        if (price <= 1000)
        {
            discount = price * 0.02;
        }
        else if (price <= 3000)
        {
            discount = price * 0.10;
        }
        else
        {
            discount = price * 0.15;
        }

        finalPrice = price - discount;
    }

    void display()
    {
        cout << "\nBook Name: " << Bname << endl;
        cout << "Price after discount: Rs. " << finalPrice << endl;
    }
};

int main()
{
    BookFair obj;

    obj.Input();
    obj.calculate();
    obj.display();

    return 0;
}
