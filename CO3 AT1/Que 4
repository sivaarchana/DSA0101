#include <iostream>
#include <string>
using namespace std;

class String
{
    string str;

public:

    // Constructor
    String(string s = "")
    {
        str = s;
    }

    // Overload ==
    bool operator==(String s)
    {
        return str == s.str;
    }

    // Overload >
    bool operator>(String s)
    {
        return str > s.str;
    }

    // Overload <
    bool operator<(String s)
    {
        return str < s.str;
    }
};

int main()
{
    String s1("Apple");
    String s2("Banana");

    if (s1 == s2)
        cout << "Both strings are equal." << endl;

    if (s1 > s2)
        cout << "First string is greater." << endl;

    if (s1 < s2)
        cout << "First string is smaller." << endl;

    return 0;
}
