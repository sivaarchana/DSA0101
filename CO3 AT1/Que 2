#include <iostream>
#include <string>
using namespace std;

class books
{
    string author;
    string title;
    string publisher;
    double price;
    int stock;

    // Private function to update price
    void updatePrice(double newPrice)
    {
        price = newPrice;
    }

public:

    // Constructor
    books(string a, string t, double p, string pub, int s)
    {
        author = a;
        title = t;
        price = p;
        publisher = pub;
        stock = s;
    }

    // Display book details
    void display()
    {
        cout << "\nBook Details" << endl;
        cout << "Title     : " << title << endl;
        cout << "Author    : " << author << endl;
        cout << "Publisher : " << publisher << endl;
        cout << "Price     : Rs. " << price << endl;
        cout << "Stock     : " << stock << endl;
    }

    // Search and purchase book
    bool purchase(string t, string a, int copies)
    {
        if (title == t && author == a)
        {
            cout << "\nBook is available." << endl;

            display();

            if (copies <= stock)
            {
                double total = copies * price;

                cout << "\nTotal Cost: Rs. " << total << endl;

                // Update stock automatically
                stock = stock - copies;

                cout << "Transaction successful." << endl;
                cout << "Remaining Stock: " << stock << endl;

                return true;
            }
            else
            {
                cout << "\nRequired copies not in stock" << endl;
                return false;
            }
        }

        return false;
    }

    // Public function to change price
    void changePrice(double newPrice)
    {
        updatePrice(newPrice);
        cout << "\nPrice updated successfully." << endl;
    }

    // Check whether book matches search
    bool search(string t, string a)
    {
        return (title == t && author == a);
    }
};

int main()
{
    // Creating objects using constructor
    books b1("R.K. Narayan", "The Guide", 450,
             "Indian Publishers", 10);

    books b2("Chetan Bhagat", "Five Point Someone", 300,
             "Rupa Publications", 5);

    books b3("A.P.J. Abdul Kalam", "Wings of Fire", 500,
             "Universities Press", 8);

    int successful = 0;
    int unsuccessful = 0;

    string title, author;
    int copies;

    cout << "===== BOOK SHOP INVENTORY =====" << endl;

    cout << "\nEnter book title: ";
    getline(cin, title);

    cout << "Enter author name: ";
    getline(cin, author);

    cout << "Enter number of copies required: ";
    cin >> copies;

    bool found = false;
    bool transaction = false;

    // Search in books
    if (b1.search(title, author))
    {
        found = true;
        transaction = b1.purchase(title, author, copies);
    }
    else if (b2.search(title, author))
    {
        found = true;
        transaction = b2.purchase(title, author, copies);
    }
    else if (b3.search(title, author))
    {
        found = true;
        transaction = b3.purchase(title, author, copies);
    }

    if (!found)
    {
        cout << "\nBook is not available." << endl;
        unsuccessful++;
    }
    else if (transaction)
    {
        successful++;
    }
    else
    {
        unsuccessful++;
    }

    // Update price example
    b1.changePrice(500);

    // Display statistics
    cout << "\n===== TRANSACTION STATISTICS =====" << endl;
    cout << "Successful Transactions   : " << successful << endl;
    cout << "Unsuccessful Transactions : " << unsuccessful << endl;

    return 0;
}
